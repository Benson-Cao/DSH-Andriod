<shortcuts xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        For shortcut.xml:
        If applicationId in build.gradle is changed from "com.dsh.harness", then targetPackage will
        need to be manually patched since ${applicationId} variable or resource string does not work.
        If package name in AndroidManifest is changed from "com.dsh.harness", then targetClass will
        need to be manually patched since dot (.) prefix does not work to automatically prefix the
        package name.
    -->

    <shortcut
        android:shortcutId="new_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.dsh.harness"
            android:targetClass="com.dsh.harness.app.TermuxActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

    <shortcut
        android:shortcutId="new_failsafe_session"
        android:enabled="true"
        android:icon="@drawable/ic_new_session"
        android:shortcutShortLabel="@string/action_new_session_failsafe"
        tools:targetApi="n_mr1">
        <intent
            android:action="android.intent.action.RUN"
            android:targetPackage="com.dsh.harness"
            android:targetClass="com.dsh.harness.app.TermuxActivity"
            android:name="android.shortcut.conversation">
            <extra android:name="com.dsh.harness.app.failsafe_session" android:value="true"/>
        </intent>
    </shortcut>

    <!-- v31：设置快捷方式改指 Compose 原生设置页（mobile.SettingsActivity）。
         原指向 com.dsh.harness.app.activities.SettingsActivity —— fork 重命名包后
         该类实际在 com.termux.app.activities 下，此快捷方式一直是坏的。 -->
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/shortcut_app_settings_short"
        android:shortcutLongLabel="@string/shortcut_app_settings_long"
        tools:targetApi="n_mr1">
        <intent
            android:action="com.dsh.harness.action.OPEN_APP_SETTINGS"
            android:targetPackage="com.dsh.harness"
            android:targetClass="com.dsh.harness.mobile.SettingsActivity"
            android:name="android.shortcut.conversation"/>
    </shortcut>

</shortcuts>
