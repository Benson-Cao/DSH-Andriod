<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- r164：Android 12+ 系统 SplashScreen（必须包含 v23 的全部 items ——
         同名 style 跨 config 是"取最佳匹配"而非逐项合并，v31 设备只看这里）。 -->
    <style name="Theme.DshSplash" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dsh_boot_bg</item>
        <item name="android:statusBarColor">@color/dsh_boot_bg</item>
        <item name="android:navigationBarColor">@color/dsh_boot_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/dsh_boot_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
